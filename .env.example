# Example environment variables
PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/slot_db
JWT_SECRET=your_jwt_secret
NODE_ENV=development

# N999Bet default club deployment
N999BET_DEFAULT_CLUB_ID=1
N999BET_SLOTOPOL_CLUB_ID=1
N999BET_DEFAULT_COUNTRY=MM
N999BET_DEFAULT_CURRENCY=MMK
N999BET_DEFAULT_LOCALE=my-MM

# Slotopol provider boundary
# These are CLUB/PROVIDER service accounts, never customer UIDs.
SLOTOPOL_URL=http://localhost:8080
SLOTOPOL_ADMIN_EMAIL=
SLOTOPOL_ADMIN_PASSWORD=
SLOTOPOL_DEFAULT_CID=1
SLOTOPOL_DEFAULT_UID=
# Example multi-club mapping. For N999Bet, entry "1" must use cid=1.
SLOTOPOL_CLUB_ACCOUNTS={"1":{"cid":1,"uid":123}}
