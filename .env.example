# Example environment variables
PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/slot_db
JWT_SECRET=your_jwt_secret
NODE_ENV=development
SLOTOPOL_URL=http://localhost:8080
SLOTOPOL_ADMIN_EMAIL=admin@slotopol.com
SLOTOPOL_ADMIN_PASSWORD=admin123

# N999Bet / Slotopol provider boundary
# These are CLUB/PROVIDER service accounts, never customer UIDs.
N999BET_DEFAULT_CLUB_ID=1
SLOTOPOL_DEFAULT_CID=1
SLOTOPOL_DEFAULT_UID=
# Example multi-club mapping:
# SLOTOPOL_CLUB_ACCOUNTS={"1":{"cid":1,"uid":123},"2":{"cid":2,"uid":456}}
SLOTOPOL_CLUB_ACCOUNTS={}
SLOTOPOL_ADMIN_EMAIL=
SLOTOPOL_ADMIN_PASSWORD=
SLOTOPOL_URL=
