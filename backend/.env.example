# N999Bet backend production environment
NODE_ENV=production
PORT=5000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=n999bet
DB_PASSWORD=CHANGE_ME
DB_NAME=n999bet
DB_SSL=true
DB_CONNECTION_LIMIT=10

# Authentication: generate a unique secret of at least 32 characters.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32_CHARS_MIN
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# CORS: comma-separated URLs are supported by the deployment configuration.
FRONTEND_URL=https://YOUR-PLAYER-DOMAIN
ADMIN_URL=https://YOUR-EMPLOYEE-ADMIN-DOMAIN
SUPER_ADMIN_URL=https://YOUR-SUPER-ADMIN-DOMAIN
MAIN_ADMIN_URL=https://YOUR-MAIN-ADMIN-DOMAIN

# Slotopol provider integration
SLOTOPOL_URL=https://YOUR-SLOTOPOL-SERVER
SLOTOPOL_ADMIN_EMAIL=CHANGE_ME
SLOTOPOL_ADMIN_PASSWORD=CHANGE_ME
N999BET_SLOTOPOL_CLUB_ID=1

# Environment-backed administrator accounts. Do not commit real passwords.
SUPER_ADMIN_USERNAME=CHANGE_ME
SUPER_ADMIN_PASSWORD=CHANGE_ME
MAIN_ADMIN_USERNAME=CHANGE_ME
MAIN_ADMIN_PASSWORD=CHANGE_ME
ADMIN_USERNAME=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
EMPLOYEE_USERNAME=CHANGE_ME
EMPLOYEE_PASSWORD=CHANGE_ME

# N999Bet withdrawal policy
N999BET_MIN_WITHDRAW=5000
